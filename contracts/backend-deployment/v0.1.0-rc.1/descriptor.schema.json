{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Exact metadata deployment identity. Validate project/role/alias/base_url correlations and openapi_sha256 against the installed contract. This artifact grants no Product capability.",
  "properties": {
    "capabilities": {
      "additionalProperties": false,
      "properties": {
        "attendee_sessions": {
          "const": false
        },
        "presenter": {
          "const": false
        },
        "world_forge": {
          "const": false
        },
        "world_publication": {
          "const": false
        }
      },
      "required": [
        "attendee_sessions",
        "presenter",
        "world_forge",
        "world_publication"
      ],
      "type": "object"
    },
    "contract": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "dreamland.deployment-control"
        },
        "openapi_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "version": {
          "const": "0.1.0-rc.1"
        }
      },
      "required": [
        "name",
        "version",
        "openapi_sha256"
      ],
      "type": "object"
    },
    "credential_id": {
      "pattern": "^credential:[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "image": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "kind": {
      "const": "dreamland.backend-handoff"
    },
    "paths": {
      "additionalProperties": false,
      "properties": {
        "health": {
          "const": "/deployment/v1/health"
        },
        "identity": {
          "const": "/deployment/v1/identity"
        },
        "readiness": {
          "const": "/deployment/v1/readiness"
        }
      },
      "required": [
        "identity",
        "health",
        "readiness"
      ],
      "type": "object"
    },
    "product_contracts": {
      "maxItems": 0,
      "type": "array"
    },
    "project": {
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,38}[a-z0-9])?$",
      "type": "string"
    },
    "revision": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "role": {
      "enum": [
        "attendee",
        "operator"
      ],
      "type": "string"
    },
    "schema_version": {
      "const": "0.1.0-rc.1"
    },
    "transport": {
      "additionalProperties": false,
      "properties": {
        "alias": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,39}-(attendee|operator)-api$",
          "type": "string"
        },
        "base_url": {
          "pattern": "^http://[a-z0-9][a-z0-9-]{0,39}-(attendee|operator)-api:8080$",
          "type": "string"
        },
        "kind": {
          "const": "docker-network"
        },
        "network": {
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
          "type": "string"
        },
        "port": {
          "const": 8080,
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "network",
        "alias",
        "port",
        "base_url"
      ],
      "type": "object"
    }
  },
  "required": [
    "kind",
    "schema_version",
    "project",
    "role",
    "image",
    "revision",
    "credential_id",
    "transport",
    "contract",
    "paths",
    "capabilities",
    "product_contracts"
  ],
  "title": "DREAMLAND metadata-only backend handoff",
  "type": "object"
}
