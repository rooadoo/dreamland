        "properties": {
          "publication_status": {
            "const": "published"
          }
        }
      },
      "then": {
        "properties": {
          "backend_commit": {
            "pattern": "^[0-9a-f]{40}$",
            "type": "string"
          },
          "published_at": {
            "format": "date-time",
            "maxLength": 64,
            "type": "string"
          }
        }
      }
    }
  ],
  "properties": {
