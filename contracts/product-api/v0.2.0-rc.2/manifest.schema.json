        },
        "refresh_command": {
          "const": ".venv/bin/python tools/product_lifecycle_contract.py refresh contracts/product-api/v0.2.0-rc.2",
          "type": "string"
        },
        "validate_command": {
          "const": ".venv/bin/python tools/product_lifecycle_contract.py validate contracts/product-api/v0.2.0-rc.2",
          "type": "string"
        }
      },
      "required": [
        "validate_command",
        "refresh_command",
        "client_smoke_command"
      ],
      "type": "object"
