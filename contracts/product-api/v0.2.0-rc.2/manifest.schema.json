        "declared_revision",
        "enabled",
        "enabled_revision",
        "reason"
      ],
      "type": "object"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "$id": "https://dreamland.invalid/contracts/product-api/v0.2.0-rc.2/manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
