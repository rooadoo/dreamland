  "servers": [],
  "x-dreamland-idempotency-policy": {
    "claim_boundary": {
      "claimed": {
        "deterministic_rejections": [
          {
            "category": "launch_grant_rejected",
            "operation_families": [
              "create_lifecycle_preview"
            ],
            "wire_codes": [
              "authority_denied"
            ]
          },
          {
            "category": "current_session_already_exists",
            "operation_families": [
              "create_lifecycle_preview"
            ],
            "wire_codes": [
              "current_session_exists"
            ]
          },
          {
            "category": "session_reference_or_capability_rejected",
            "operation_families": [
              "close_lifecycle_preview"
            ],
            "wire_codes": [
              "authority_denied"
            ]
          },
          {
            "category": "control_revision_changed",
            "operation_families": [
              "close_lifecycle_preview"
            ],
            "wire_codes": [
              "control_revision_conflict"
            ]
          },
          {
            "category": "key_already_bound_to_another_body",
            "operation_families": [
              "close_lifecycle_preview",
              "create_lifecycle_preview"
            ],
            "wire_codes": [
              "idempotency_conflict"
            ]
          }
        ],
        "different_body": "return_idempotency_conflict_without_mutation",
        "fresh_metadata_may_differ": [
          "observed_at",
          "replayed",
          "request_id"
        ],
        "postclaim_terminal_default": "record_and_replay_before_response",
        "same_body": "replay_recorded_logical_outcome_and_status",
        "successful_results": [
          "closed",
          "created"
        ]
      },
      "preclaim": {
        "binds_key": false,
        "reservation_point": "after private service authentication, current expected epoch, authorized actor context, valid idempotency key, and canonical semantic body; before resource-authority and deterministic business checks",
        "same_key_changed_body": "permitted_because_no_binding_exists",
        "wire_error_categories": [
          {
            "category": "private_service_authentication_or_route_availability",
            "wire_codes": [
              "unauthorized",
              "not_found"
            ]
          },
          {
            "category": "missing_malformed_or_stale_expected_epoch",
            "wire_codes": [
              "expected_epoch_required",
              "invalid_request",
              "outcome_unknown"
            ]
          },
          {
            "category": "actor_context_rejected_before_resource_authority",
            "wire_codes": [
              "authority_denied",
              "invalid_request"
            ]
          },
          {
            "category": "malformed_key_headers_media_or_body_before_canonicalization",
            "wire_codes": [
              "content_length_required",
              "invalid_json",
              "invalid_request",
              "request_too_large",
              "unsupported_media_type"
            ]
          },
          {
            "category": "internal_failure_before_reservation",
            "wire_codes": [
              "internal_error"
            ]
          }
        ]
      },
      "transient_unclaimed": [
        {
          "category": "capacity_check_before_work",
          "client_guidance": "retry_only_the_identical_key_and_body_after_retry_delay",
          "key_binding": "none",
          "same_key_changed_body": "permitted_because_no_binding_exists_but_a_fresh_key_is_recommended",
          "wire_codes": [
            "capacity_exhausted"
          ]
        }
      ]
    },
    "epoch_namespace": {
      "deliberate_fresh_work_requires": [
        "current_epoch_evidence",
        "current_epoch_authority",
        "new_idempotency_key"
      ],
      "prior_epoch_records": "not_replayed_in_the_new_epoch",
      "rotation": "terminates_the_prior_in_memory_namespace",
      "stale_mutation_claims_current_epoch_key": false,
      "stale_mutation_wire_code": "outcome_unknown"
    },
    "retention": {
      "cleanup_rule": "remove_only_after_the_applicable_retention_scope_expires; a removed failed-operation binding may be claimed again within the live epoch",
      "session_related_records": "at_least_through_related_session_and_tombstone_cleanup",
      "unrelated_claimed_failures": {
        "scope": "bounded_failed_operation_retention",
        "ttl_configuration": "failed_operation_ttl_ms"
      }
    },
    "scope": {
      "authority_class_definition": "stable_authenticated_actor_role_not_resource_authority_evidence",
      "coordinates": [
        "service_epoch",
        "actor_context",
        "authority_class",
        "operation_family",
        "idempotency_key"
      ],
      "first_body_binding": "canonical_semantic_request_body",
      "operation_families": [
        "close_lifecycle_preview",
        "create_lifecycle_preview"
      ],
      "request_authority_storage": {
        "comparison_material": "sha256_digest",
        "raw_request_authority_in_scope_body_or_failure_records": "forbidden",
        "successful_result_authority": "a bounded generated session capability may be retained in active session state for current recovery and in its successful create replay result; terminalization removes the active-state copy and related tombstone cleanup removes the replay-result copy"
      }
    },
    "version": 1,
    "wire_code_resolution": {
      "close_resource_authority_rejection": "authority_denied",
      "create_resource_authority_rejection": "authority_denied",
      "grant_unavailable": "declared_safe_error_code_not_emitted_by_rc2_mutations",
      "not_found": "preclaim_route_or_nonmutation_code_not_emitted_for_postclaim_close_resource_rejection"
    }
  }
}
