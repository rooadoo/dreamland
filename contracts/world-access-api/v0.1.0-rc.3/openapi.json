            "type": "object"
          },
          "expires_at": {
            "format": "date-time",
            "maxLength": 64,
            "minLength": 20,
            "type": "string"
          },
          "notice_version": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "type": "string"
