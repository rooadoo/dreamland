{
  "components": {
    "parameters": {
      "ActorContext": {
        "in": "header",
        "name": "X-Dreamland-Actor-Context",
        "required": true,
        "schema": {
          "maxLength": 512,
          "minLength": 16,
          "pattern": "^[\\x21-\\x7e]+$",
          "type": "string"
        }
      },
      "ExpectedEpoch": {
        "in": "header",
        "name": "X-Dreamland-Expected-Epoch",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/ServiceEpoch"
        }
      },
      "IdempotencyKey": {
        "in": "header",
        "name": "Idempotency-Key",
        "required": true,
        "schema": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[\\x21-\\x7e]+$",
          "type": "string"
        }
      },
      "RequestId": {
        "in": "header",
        "name": "X-Request-Id",
        "required": false,
        "schema": {
          "$ref": "#/components/schemas/RequestId"
        }
      }
    },
