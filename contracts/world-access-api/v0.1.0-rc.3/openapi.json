          "expected_error_code": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "type": "string"
          },
          "expected_http_status": {
            "maximum": 599,
            "minimum": 400,
            "type": "integer"
