          "request_id",
          "contract",
          "preview",
          "kind",
          "service_epoch",
          "promotion_id",
          "access_record_id",
          "revision_number",
          "state",
          "origin",
          "revision",
          "created_at",
          "changed_at",
          "expires_at",
          "catalog_eligible",
          "replayed"
        ],
        "type": "object"
      },
      "RequestId": {
        "maxLength": 128,
        "minLength": 8,
        "pattern": "^[A-Za-z0-9_.:-]+$",
        "type": "string"
      },
      "RevealRequest": {
        "additionalProperties": false,
        "properties": {
          "expected_access_record_id": {
            "$ref": "#/components/schemas/AccessRecordId"
          }
        },
        "required": [
          "expected_access_record_id"
        ],
        "type": "object"
      },
      "SafeError": {
        "additionalProperties": false,
        "oneOf": [
          {
            "properties": {
              "retry": {
                "const": "after_delay"
              },
              "retry_after_ms": {
                "maximum": 60000,
                "minimum": 1,
                "type": "integer"
              }
            },
            "required": [
              "retry",
              "retry_after_ms"
            ]
          },
          {
            "properties": {
              "retry": {
                "const": "none"
              },
              "retry_after_ms": {
                "type": "null"
              }
            },
            "required": [
              "retry",
              "retry_after_ms"
            ]
          },
          {
            "properties": {
              "retry": {
                "const": "same_request"
              },
              "retry_after_ms": {
                "type": "null"
              }
            },
            "required": [
              "retry",
              "retry_after_ms"
            ]
          }
        ],
        "properties": {
          "code": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "type": "string"
          },
          "message": {
            "maxLength": 160,
            "minLength": 1,
            "type": "string"
          },
          "retry": {
            "enum": [
              "none",
              "same_request",
              "after_delay"
            ],
            "type": "string"
          },
          "retry_after_ms": {
            "oneOf": [
              {
                "maximum": 60000,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "code",
          "message",
          "retry",
          "retry_after_ms"
        ],
        "type": "object"
      },
      "SafeErrorEnvelope": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/SafeError"
          },
          "request_id": {
            "$ref": "#/components/schemas/RequestId"
          }
        },
        "required": [
          "request_id",
          "error"
        ],
        "type": "object"
      },
      "ServiceEpoch": {
        "pattern": "^epoch:[A-Za-z0-9_-]{16,128}$",
        "type": "string"
      }
    },
    "securitySchemes": {
      "PrivateBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
